# ============================================================
# Required - minimum to run the app
# ============================================================

# Convex deployment (from `bunx convex dev`)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# BetterAuth base URL (http://localhost:3000 for dev)
SITE_URL=http://localhost:3000

# ============================================================
# Optional - integrations
# ============================================================
# AniList OAuth app (for connecting anime service)
VITE_ANILIST_CLIENT_ID=

# Kagome tokenizer backend (SST-deployed Lambda)
VITE_KAGOME_TOKENIZE_URL=

# PostHog analytics (frontend)
VITE_POSTHOG_KEY=
